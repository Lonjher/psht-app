{
  "expo": {
    "name": "PSHT App",
    "slug": "psht-app",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "psht-app",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {},
      "package": "com.lonjher.pshtapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "reactNativeAndroidArchitectures": "armeabi-v7a,arm64-v8a"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a07d9797-e6b7-4242-87a2-0c370fd0f1d5"
      }
    },
    "owner": "lonjher"
  }
}
